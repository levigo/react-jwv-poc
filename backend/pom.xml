<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <groupId>org.jadice.jwv</groupId>
    <artifactId>react-jwv-poc</artifactId>
    <version>7.28.1</version>

    <description>Getting Started with the jadice web viewer</description>
    <url>https://levigo.de/info/x/MwLMCg</url>

    <modelVersion>4.0.0</modelVersion>

    <properties>
        <!-- General project settings -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- levigo dependencies -->
        <jwv.version>7.28.1</jwv.version>
        <!-- Must match the Spring Boot version the jadice web toolkit release is built with. -->
        <spring-boot.version>4.1.2</spring-boot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.levigo.jadice.webtoolkit</groupId>
            <artifactId>webtoolkit-ng-server</artifactId>
            <version>${jwv.version}</version>
        </dependency>

        <!-- Stellt den /upload-Endpoint (UploadController) bereit, ueber den der
             Client per "Open File" Dokumente hochlaedt. Ohne dieses Addon liefert
             POST /upload ein 404. -->
        <dependency>
            <groupId>com.levigo.jadice.webtoolkit</groupId>
            <artifactId>webtoolkit-addon-upload</artifactId>
            <version>${jwv.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Manages the Spring versions, including spring-security-web and
                spring-security-config above. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <!-- Let's import the jadice web toolkit bill of material. JWT dependency
                versions are managed via this BOM. -->
            <dependency>
                <groupId>com.levigo.jadice.webtoolkit</groupId>
                <artifactId>webtoolkit-bom</artifactId>
                <version>${jwv.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>